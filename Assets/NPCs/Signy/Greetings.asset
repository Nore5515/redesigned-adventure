  m_Name: Greetings
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  lines:
  - text: Buy something, please.
    talkingSprites: {fileID: 11400000, guid: 1a312b26748fb024a94261fee1846d3e, type: 2}
    duration: 1
    endSprites: {fileID: 11400000, guid: 1a312b26748fb024a94261fee1846d3e, type: 2}
  - text: Yes?
    talkingSprites: {fileID: 11400000, guid: 1a312b26748fb024a94261fee1846d3e, type: 2}
    duration: 1
    endSprites: {fileID: 11400000, guid: 1a312b26748fb024a94261fee1846d3e, type: 2}
  - text: I miss being inanimate. It was simpler.
    talkingSprites: {fileID: 11400000, guid: 1a312b26748fb024a94261fee1846d3e, type: 2}
    duration: 1
    endSprites: {fileID: 11400000, guid: 1a312b26748fb024a94261fee1846d3e, type: 2}
